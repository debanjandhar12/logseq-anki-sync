{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            // Workaround for assistant-ui bugged registry that causes
            // double nesting in import paths of shadcn during pnpm shadcn@latest add.
            "src/shadcn/assistant-ui/assistant-ui/*": ["src/shadcn/assistant-ui/*"],
            // Required for src/ imports used in shadcn
            "src/*": ["src/*"]
        },
        "target": "ES2020",
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "types": ["vite/client", "node"],
        "allowJs": false,
        "skipLibCheck": true,
        "esModuleInterop": false,
        "allowSyntheticDefaultImports": true,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "module": "ES2020",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx"
    },
    "include": ["./src", "./src/types/*.d.ts", "./tests"]
}
