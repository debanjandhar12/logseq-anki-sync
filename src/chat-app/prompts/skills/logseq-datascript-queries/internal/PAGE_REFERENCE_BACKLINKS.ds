[:find (pull ?b [:block/uuid :block/title])
 :in $ ?page-name
 :where
 [?p :block/name ?page-name]
 (not [?p :logseq.property/deleted-at])
 [?b :block/refs ?p]
 [?b :block/title]
 (not [?b :logseq.property/deleted-at])
 (not-join [?b]
   [?b :block/page ?owner]
   [?owner :logseq.property/deleted-at])]
